# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synthetic_persona
POSTGRES_USER=spb_user
POSTGRES_PASSWORD=changeme

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Leave empty for the passwordless local container
REDIS_PASSWORD=

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Qdrant ─────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Airflow ────────────────────────────────────────────────
AIRFLOW_HOME=./airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme

# ── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed by CORS (defaults to localhost dev ports)
# CORS_ORIGINS=http://localhost:5173
# Simulation requests allowed per org per minute
SIMULATE_RATE_LIMIT=60
# Concurrent jobs per ARQ worker
SIMULATION_MAX_CONCURRENT=5
# Disk cache for Claude responses (repeat calls cost zero tokens)
CACHE_DIR=./data/cache
# Days after which a segment's training is considered stale
SEGMENT_STALE_THRESHOLD_DAYS=7

# ── Auth ────────────────────────────────────────────────────
# false → all requests use GUEST_CLAIMS (admin, default org) — safe for local dev
# true  → JWT or X-API-Key header required on every protected route
AUTH_REQUIRED=false
# dev        → POST /auth/dev-token is enabled (never enable in production)
# production → dev-token endpoint returns 404
AUTH_MODE=dev
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The API refuses to start with ENV=production and a default / <32-char secret.
JWT_SECRET=dev-secret-change-in-production
# Optional claim validation and dev-token lifetime
# JWT_ALGORITHM=HS256
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_EXPIRY_SECONDS=3600

# ── Privacy ─────────────────────────────────────────────────
# HMAC salt used to anonymize user ids. Required (non-default) when ENV=production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_SALT=dev-only-salt-change-in-prod

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Environment ────────────────────────────────────────────
ENV=development
