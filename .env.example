# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synthetic_persona
POSTGRES_USER=spb_user
POSTGRES_PASSWORD=changeme

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Qdrant ─────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Airflow ────────────────────────────────────────────────
AIRFLOW_HOME=./airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme

# ── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Auth ────────────────────────────────────────────────────
# false → all requests use GUEST_CLAIMS (admin, default org) — safe for local dev
# true  → JWT or X-API-Key header required on every protected route
AUTH_REQUIRED=false
# dev        → POST /auth/dev-token is enabled (never enable in production)
# production → dev-token endpoint returns 404
AUTH_MODE=dev
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Environment ────────────────────────────────────────────
ENV=development
