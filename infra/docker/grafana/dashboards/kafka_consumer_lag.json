{
  "title": "Kafka Consumer Lag",
  "uid": "spb-kafka-consumer-lag",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Consumer Lag by Group & Topic",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{consumergroup=\"behavioral-consumer-group\"}",
          "legendFormat": "{{topic}} / {{partition}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Total Consumer Lag (all partitions)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"behavioral-consumer-group\"})",
          "legendFormat": "Total Lag",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Messages Consumed / sec",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 16, "h": 4 },
      "targets": [
        {
          "expr": "rate(kafka_topic_partition_current_offset{topic=~\"events\\\\.*\"}[1m])",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    }
  ]
}
